# VibeMessenger — пример конфигурации
# Скопируйте в .env и заполните. Настоящий .env не коммитится.

# Домен, на который указывает A-запись (без http://). SSL выпустится автоматически.
DOMAIN=chat.example.com

# Email для Let's Encrypt
ACME_EMAIL=you@example.com

# Порт HTTPS (по умолчанию 443)
HTTPS_PORT=443

# Секрет для подписи токенов. Сгенерируйте: openssl rand -hex 48
MESSENGER_SECRET=change_me
